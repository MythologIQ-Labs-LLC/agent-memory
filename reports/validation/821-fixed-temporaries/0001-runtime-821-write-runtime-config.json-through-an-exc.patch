 def _atomic_write_text(path: Path, text: str) -> None:
     path.parent.mkdir(parents=True, exist_ok=True)
-    temporary = path.with_name(f".{path.name}.tmp")
-    with temporary.open("w", encoding="utf-8", newline="\n") as handle:
-        handle.write(text)
-        if not text.endswith("\n"):
-            handle.write("\n")
-        handle.flush()
-        os.fsync(handle.fileno())
-    os.replace(temporary, path)
+    temporary, descriptor = _exclusive_temporary(path)
+    try:
+        try:
+            handle = os.fdopen(descriptor, "w", encoding="utf-8", newline="\n")
+        except BaseException:
+            os.close(descriptor)
+            raise
+        with handle:
+            handle.write(text)
+            if not text.endswith("\n"):
+                handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+    except BaseException:
+        try:
+            os.unlink(temporary)
+        except OSError:
+            pass
+        raise
+
+
+def _exclusive_temporary(path: Path) -> tuple[Path, int]:
+    """A temporary only this writer can have opened (#821, as for the generation witness).
+
+    With one shared ``.<name>.tmp``, two processes opening a new store could truncate each
+    other's inode, and a crash in between published an empty ``runtime-config.json`` that refused
+    every later open; a pre-planted symlink or FIFO at that predictable name was followed or
+    blocked on. ``O_EXCL`` with an unpredictable name refuses any existing path. The mode stays
+    ``0o666`` less the umask, as ``open("w")`` created it."""
+
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0)
+    for _ in range(8):
+        temporary = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(8)}.tmp")
+        try:
+            return temporary, os.open(temporary, flags, 0o666)
+        except FileExistsError:
+            continue
+    raise FileExistsError(f"no unused temporary name for {path.name}")
 
 
