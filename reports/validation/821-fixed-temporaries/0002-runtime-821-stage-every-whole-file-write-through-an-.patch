diff --git a/reference/agentmem_ref/core/atomic_files.py b/reference/agentmem_ref/core/atomic_files.py
new file mode 100644
index 00000000..d27a5372
--- /dev/null
+++ b/reference/agentmem_ref/core/atomic_files.py
@@ -0,0 +1,56 @@
+"""Whole-file replacement through a temporary only its writer can have opened (#821).
+
+Writers used to stage into one shared ``.<name>.tmp`` (or ``<name>.tmp``) opened with truncation.
+Two processes writing the same file could truncate each other's inode, so a crash between them
+published an empty file; a symlink planted at that predictable name was followed, overwriting a
+file elsewhere; a FIFO planted there blocked the writer. ``O_EXCL`` with an unpredictable name
+refuses any existing path. Standard library only: the evaluation package uses it without importing
+the runtime.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import secrets
+
+
+def exclusive_temporary(path: Path) -> tuple[Path, int]:
+    """Create ``.<name>.<pid>.<random>.tmp`` beside ``path`` and return it with its descriptor.
+
+    The mode stays ``0o666`` less the umask, as ``open("wb")`` created it."""
+
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0)
+    for _ in range(8):
+        temporary = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(8)}.tmp")
+        try:
+            return temporary, os.open(temporary, flags, 0o666)
+        except FileExistsError:
+            continue
+    raise FileExistsError(f"no unused temporary name for {path.name}")
+
+
+def replace_with_bytes(path: Path, payload: bytes, *, durable: bool = True) -> None:
+    """Write ``payload`` to an exclusive temporary (fsynced when ``durable``) and rename it onto
+    ``path``. On any failure before the rename, the temporary is closed and removed and ``path`` is
+    untouched. The caller creates the directory and, where it needs to, fsyncs it afterwards."""
+
+    temporary, descriptor = exclusive_temporary(path)
+    try:
+        try:
+            handle = os.fdopen(descriptor, "wb")
+        except BaseException:
+            os.close(descriptor)
+            raise
+        with handle:
+            handle.write(payload)
+            if durable:
+                handle.flush()
+                os.fsync(handle.fileno())
+        os.replace(temporary, path)
+    except BaseException:
+        try:
+            os.unlink(temporary)
+        except OSError:
+            pass
+        raise
