@@ -0,0 +1,266 @@
+"""#821 follow-up: every whole-file writer stages through a temporary only it can open.
+
+Up to ``5ca4bc5b`` six writers staged into one fixed name opened with truncation, the pattern R-1
+found in the generation witness and ``runtime-config.json``:
+
+- ``runtime.restart_runtime._atomic_json_write`` (file-checkpoint profile), ``.<name>.tmp``
+- ``runtime.checkpoint_transactions`` journal restore, ``.<name>.tmp``
+- ``runtime.configured_restart._atomic_json_write`` (legacy binding file), ``.<name>.tmp``
+- ``memory.checkpoint_migration._atomic_json_write``, ``.<name>.tmp``
+- ``evaluation.contract.write_run``, ``<name>.tmp``
+- ``evaluation.gauntlet_orchestrator._write_json``, ``<name>.tmp``
+
+A writer killed beside another truncated the inode the other was about to rename, publishing an
+empty file; a symlink at the fixed name was followed; a FIFO there blocked the writer; a failed
+write left its temporary behind. The checkpoint writers also hold the checkpoint lock, so for them
+the race needs a second writer outside it; the planted paths and the hygiene do not.
+
+All of them now go through ``core.atomic_files``. Faults are injected at the OS boundary only. Tests marked FAIL-FIRST fail on ``5ca4bc5b``.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from agentmem_ref.evaluation import contract  # noqa: E402
+from agentmem_ref.evaluation import gauntlet_orchestrator  # noqa: E402
+from agentmem_ref.memory import checkpoint_migration  # noqa: E402
+from agentmem_ref.runtime import checkpoint_transactions, configured_restart, restart_runtime  # noqa: E402
+from tests.test_memory_evaluation_cli import _report  # noqa: E402
+
+REFERENCE = Path(__file__).resolve().parents[1]
+CRASH = 77
+VALUE = {"generation": 7, "note": "durable value", "records": list(range(32))}
+RECORDS = ({"generation": 1, "kind": "commit"}, {"generation": 2, "kind": "commit"})
+
+
+def _journal(path: Path) -> None:
+    store = SimpleNamespace(_store=SimpleNamespace(journal_path=path))
+    checkpoint_transactions.CheckpointTransactionSupport._atomic_journal_write(store, RECORDS)
+
+
+# writer id -> (write ``path`` with that writer, the fixed temporary name it used to stage into)
+WRITERS = {
+    "restart_runtime": (lambda p: restart_runtime._atomic_json_write(p, VALUE), lambda n: f".{n}.tmp"),
+    "checkpoint_transactions": (_journal, lambda n: f".{n}.tmp"),
+    "configured_restart": (lambda p: configured_restart._atomic_json_write(p, VALUE), lambda n: f".{n}.tmp"),
+    "checkpoint_migration": (lambda p: checkpoint_migration._atomic_json_write(p, VALUE), lambda n: f".{n}.tmp"),
+    "evaluation_contract": (lambda p: contract.write_run(p, _report("agent-memory", 0.7)), lambda n: f"{n}.tmp"),
+    "gauntlet_orchestrator": (lambda p: gauntlet_orchestrator._write_json(p, VALUE), lambda n: f"{n}.tmp"),
+}
+NAME = "state.json"
+
+# argv: reference writer path role barrier. Role A holds its rename until B is done; role B dies as
+# soon as it has opened a temporary of the target for writing, before writing a byte.
+_WRITER = r"""
+import io, os, sys, time, builtins, pathlib
+sys.path.insert(0, sys.argv[1])
+writer, target, role, barrier = sys.argv[2], pathlib.Path(sys.argv[3]), sys.argv[4], pathlib.Path(sys.argv[5])
+
+def _temporary(path):
+    try:
+        name = os.path.basename(os.fspath(path))
+    except TypeError:
+        return False
+    return name != target.name and target.name in name and name.endswith(".tmp")
+
+_io_open, _os_open, _replace = io.open, os.open, os.replace
+
+def io_open(path, mode="r", *args, **kwargs):
+    handle = _io_open(path, mode, *args, **kwargs)
+    if role == "B" and _temporary(path) and any(c in mode for c in "wax+"):
+        os._exit(77)
+    return handle
+
+def os_open(path, flags, *args, **kwargs):
+    descriptor = _os_open(path, flags, *args, **kwargs)
+    if role == "B" and _temporary(path) and flags & (os.O_WRONLY | os.O_RDWR):
+        os._exit(77)
+    return descriptor
+
+def replace(source, destination, *args, **kwargs):
+    if role == "A" and os.path.basename(os.fspath(destination)) == target.name:
+        (barrier / "a-holding").touch()
+        deadline = time.monotonic() + 120
+        while not (barrier / "b-done").exists() and time.monotonic() < deadline:
+            time.sleep(0.01)
+    return _replace(source, destination, *args, **kwargs)
+
+io.open = builtins.open = io_open
+os.open = os_open
+os.replace = replace
+from tests.test_821_fixed_temporaries import WRITERS
+WRITERS[writer][0](target)
+"""
+
+_PLAIN_WRITE = r"""
+import sys, pathlib
+sys.path.insert(0, sys.argv[1])
+from tests.test_821_fixed_temporaries import WRITERS
+WRITERS[sys.argv[2]][0](pathlib.Path(sys.argv[3]))
+"""
+
+
+class _Folder(unittest.TestCase):
+    def setUp(self) -> None:
+        self._folder = tempfile.TemporaryDirectory()
+        self.addCleanup(self._folder.cleanup)
+        self.base = Path(self._folder.name)
+
+    def folder(self, writer: str) -> Path:
+        root = self.base / writer
+        root.mkdir()
+        return root
+
+    def expected(self, writer: str) -> bytes:
+        root = self.base / f"expected-{writer}"
+        root.mkdir()
+        WRITERS[writer][0](root / NAME)
+        return (root / NAME).read_bytes()
+
+    def temporaries(self, root: Path) -> list[str]:
+        return sorted(p.name for p in root.iterdir() if p.name != NAME and NAME in p.name)
+
+    def child(self, script: str, *args: str, timeout: float = 120) -> subprocess.CompletedProcess:
+        environment = dict(os.environ, PYTHONPATH=os.pathsep.join(filter(None, [str(REFERENCE), os.environ.get("PYTHONPATH")])))
+        return subprocess.run([sys.executable, "-c", script, str(REFERENCE), *args],
+                              capture_output=True, text=True, timeout=timeout, env=environment)
+
+
+class ConcurrentWriters(_Folder):
+    def race(self, writer: str, root: Path) -> int:
+        barrier = self.base / f"barrier-{writer}"
+        barrier.mkdir()
+        environment = dict(os.environ, PYTHONPATH=os.pathsep.join(filter(None, [str(REFERENCE), os.environ.get("PYTHONPATH")])))
+        command = [sys.executable, "-c", _WRITER, str(REFERENCE), writer, str(root / NAME)]
+        a = subprocess.Popen(command + ["A", str(barrier)], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             text=True, env=environment)
+        try:
+            deadline = time.monotonic() + 120
+            while not (barrier / "a-holding").exists():
+                if a.poll() is not None or time.monotonic() > deadline:
+                    raise AssertionError(f"writer A never reached its rename: {a.communicate()[1][-2000:]}")
+                time.sleep(0.01)
+            b = subprocess.run(command + ["B", str(barrier)], capture_output=True, text=True, timeout=120, env=environment)
+        finally:
+            (barrier / "b-done").touch()
+            try:
+                _, a_err = a.communicate(timeout=120)
+            except subprocess.TimeoutExpired:
+                a.kill()
+                raise
+        if a.returncode != 0:
+            raise AssertionError(f"writer A failed ({a.returncode}): {a_err[-2000:]}")
+        return b.returncode
+
+    def test_a_writer_killed_beside_another_never_publishes_a_truncated_file(self):  # FAIL-FIRST
+        for writer in WRITERS:
+            with self.subTest(writer=writer):
+                root = self.folder(writer)
+                self.assertEqual(self.race(writer, root), CRASH)
+                # 5ca4bc5b: both used one temporary name, so A published the inode B had truncated
+                self.assertEqual((root / NAME).read_bytes(), self.expected(writer))
+
+
+class PlantedTemporaryPaths(_Folder):
+    def test_a_symlink_at_the_old_fixed_name_is_never_followed(self):  # FAIL-FIRST
+        for writer, (write, fixed) in WRITERS.items():
+            with self.subTest(writer=writer):
+                root = self.folder(writer)
+                target = self.base / f"outside-{writer}.txt"
+                target.write_text("must not change\n")
+                os.symlink(target, root / fixed(NAME))
+                write(root / NAME)
+                self.assertEqual(target.read_text(), "must not change\n")
+                self.assertFalse((root / NAME).is_symlink())
+                self.assertEqual((root / NAME).read_bytes(), self.expected(writer))
+
+    def test_a_fifo_at_the_old_fixed_name_does_not_block_the_writer(self):  # FAIL-FIRST
+        for writer, (_write, fixed) in WRITERS.items():
+            with self.subTest(writer=writer):
+                root = self.folder(writer)
+                os.mkfifo(root / fixed(NAME))
+                try:
+                    done = self.child(_PLAIN_WRITE, writer, str(root / NAME), timeout=15)
+                except subprocess.TimeoutExpired:
+                    self.fail(f"{writer} blocked on a FIFO at its old temporary name")
+                self.assertEqual(done.returncode, 0, done.stderr[-2000:])
+                self.assertEqual((root / NAME).read_bytes(), self.expected(writer))
+
+
+class TemporaryHygiene(_Folder):
+    def test_a_failed_rename_removes_the_temporary_and_publishes_nothing(self):  # FAIL-FIRST
+        for writer, (write, _fixed) in WRITERS.items():
+            with self.subTest(writer=writer):
+                root = self.folder(writer)
+                with mock.patch("os.replace", side_effect=OSError(28, "No space left on device (injected)")):
+                    with self.assertRaises(OSError):
+                        write(root / NAME)
+                self.assertFalse((root / NAME).exists())
+                self.assertEqual(self.temporaries(root), [])
+
+    def test_a_failed_rename_leaves_the_previous_file_intact(self):
+        for writer, (write, _fixed) in WRITERS.items():
+            with self.subTest(writer=writer):
+                root = self.folder(writer)
+                (root / NAME).write_bytes(b"previous\n")
+                with mock.patch("os.replace", side_effect=OSError("injected")):
+                    with self.assertRaises(OSError):
+                        write(root / NAME)
+                self.assertEqual((root / NAME).read_bytes(), b"previous\n")
+
+    def test_another_writer_temporary_is_never_opened_or_truncated(self):
+        for writer, (write, _fixed) in WRITERS.items():
+            with self.subTest(writer=writer):
+                root = self.folder(writer)
+                taken = root / f".{NAME}.{os.getpid()}.{'0' * 16}.tmp"
+                taken.write_bytes(b"another writer's bytes")
+                tokens = iter(["0" * 16, "1" * 16])
+                with mock.patch("secrets.token_hex", lambda _n: next(tokens)):
+                    write(root / NAME)
+                self.assertEqual(taken.read_bytes(), b"another writer's bytes")
+                self.assertEqual((root / NAME).read_bytes(), self.expected(writer))
+                self.assertEqual(self.temporaries(root), [taken.name])
+
+    def test_the_file_keeps_the_mode_open_wb_gave_it(self):
+        for writer, (write, _fixed) in WRITERS.items():
+            with self.subTest(writer=writer):
+                root = self.folder(writer)
+                previous = os.umask(0o027)
+                try:
+                    write(root / NAME)
+                finally:
+                    os.umask(previous)
+                self.assertEqual((root / NAME).stat().st_mode & 0o777, 0o640)
+
+    def test_contents_are_byte_identical_to_the_fixed_name_writers(self):
+        canonical = (json.dumps(VALUE, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode()
+        journal = b"".join(
+            (json.dumps(r, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode() for r in RECORDS
+        )
+        expected = {
+            "restart_runtime": canonical,
+            "checkpoint_transactions": journal,
+            "configured_restart": canonical,
+            "checkpoint_migration": canonical,
+            "evaluation_contract": contract.canonical_json_bytes(_report("agent-memory", 0.7)),
+            "gauntlet_orchestrator": canonical,
+        }
+        for writer in WRITERS:
+            with self.subTest(writer=writer):
+                self.assertEqual(self.expected(writer), expected[writer])
+
+
+if __name__ == "__main__":
+    unittest.main()
