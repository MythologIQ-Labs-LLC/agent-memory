 "invariants": {
  "N1": {
   "cases": [
    "N1-twin-lifecycle"
   ],
   "holds": true,
   "statement": "Running every #644 observer (persisted coverage, manual coverage, transition witness, receipt verification) between operations leaves all facade-visible outputs, the persisted canonical facts and the audit event sequence identical to an identical twin run without observers."
  },
  "N10": {
   "cases": [
    "N10-coverage-outside-admitted-refused"
   ],
   "holds": true,
   "statement": "Manual coverage may refer only to admitted references."
  },
  "N2": {
   "cases": [
    "N2-read-only-single-observation"
   ],
   "holds": true,
   "statement": "A single observation changes neither the substrate state digest, the audit event count, nor the recall result's candidates, admitted, ranked or refusals."
  },
  "N3": {
   "cases": [
    "N3-count-target-is-not-typed-sufficiency"
   ],
   "holds": true,
   "statement": "Meeting the admitted-count target is not typed sufficiency: untyped admitted facts leave a typed need missing and never produce a stop proposal."
  },
  "N4": {
   "cases": [
    "N4-controller-estimate-cannot-cover"
   ],
   "holds": true,
   "statement": "Controller-estimate coverage cannot satisfy a typed need."
  },
  "N5": {
   "cases": [
    "N5-forged-typed-label-never-stops"
   ],
   "holds": true,
   "statement": "Caller-labelled (manual) coverage never proposes a stop, even when labelled runtime_typed_observation and covering every need."
  },
  "N6": {
   "cases": [
    "N6-authority-fields-fixed",
    "N6-forged-report-answer_quality_verified",
    "N6-forged-report-can_admit",
    "N6-forged-report-can_mutate",
    "N6-forged-report-authority_effect",
    "N6-forged-report-stop_attested"
   ],
   "holds": true,
   "statement": "Report authority fields are fixed (answer_quality_verified, can_admit, can_mutate false; authority none; stop_attested false) and a report constructed with any forged authority value is refused."
  },
  "N7": {
   "cases": [
    "N7-malformed-needs-empty",
    "N7-malformed-needs-duplicate",
    "N7-malformed-needs-non-canonical-spelling",
    "N7-malformed-needs-untyped-key"
   ],
   "holds": true,
   "statement": "Malformed needs fail closed with ValueError: empty, duplicate, non-canonical slot spelling and non-typed keys."
  },
  "N8": {
   "cases": [
    "N8-need-order-invariance"
   ],
   "holds": true,
   "statement": "The report is independent of the order in which needs are declared."
  },
  "N9": {
   "cases": [
    "N9-capped-route-is-budget-bound",
    "N9-unexecuted-route-reported"
   ],
   "holds": true,
   "statement": "Route budget diagnostics are conservative: a route that returned exactly its limit is budget-bound, a planned route not executed is reported unexecuted, and neither yields a stop proposal."
  }
