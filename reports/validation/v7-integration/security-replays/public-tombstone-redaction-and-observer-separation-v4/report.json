  },
  "R3": {
   "cases": [
    "R3-owner-view-stable-under-other-scope-with-distinct-generation-lengths"
   ],
   "holds": true,
   "statement": "The owner's deleted view does not change when another project re-creates, corrects and deletes the same id, and each deleting scope reads exactly the version its own deletion recorded (the two generations have different lengths, so a view serving the largest or latest deletion would differ)."
