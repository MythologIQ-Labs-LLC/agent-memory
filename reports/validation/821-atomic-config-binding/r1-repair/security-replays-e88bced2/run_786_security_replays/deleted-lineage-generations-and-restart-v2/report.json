 "dsl_version": "786-security-replay-dsl/1",
 "invariants": {
  "L1": {
   "cases": [
    "L1-deletion-withholds-live",
    "L1-deletion-withholds-after-restart",
    "L5b-a-deleted-head-or-version-cannot-be-deleted-again"
   ],
   "holds": true,
   "statement": "After a governed deletion no version of the deleted generation is admitted to current or historical recall, nor by logical reference, and the owner's history reads tombstoned with no events, live and after restart."
  },
  "L2": {
   "cases": [
    "L2-owner-recreation"
   ],
   "holds": true,
   "statement": "The owner's re-creation is visible only as its own generation: old versions are withheld from recall, history and write_semantics. (The probe that a pruned version's content remains physically present is implementation evidence of the pruning/permanent-deletion distinction, docs/786 table, not a clause of the cited lineage contract.)"
  },
  "L3": {
   "cases": [
    "L3-other-project-recreation-is-isolated",
    "L4-three-generations-as-of-barriers"
   ],
   "holds": true,
   "statement": "Another project's re-creation is isolated both ways: the former owner reads nothing of it and cannot write, correct, delete or dispute it; the new generation reads nothing of the former."
  },
  "L4": {
   "cases": [
    "L4-three-generations-as-of-barriers"
   ],
   "holds": true,
   "statement": "Every deleted version is an as-of barrier for every reader, and a live generation resolves only for its owner, only from its own start."
  },
  "L5": {
   "cases": [
    "L5b-a-deleted-head-or-version-cannot-be-deleted-again",
    "L5-partial-deletion-withholds-only-that-version"
   ],
   "holds": true,
   "statement": "A governed deletion of one superseded version withholds only that version; a deleted head or lineage member cannot be deleted again (already_deleted), so a recorded generation is never rewritten or shrunk, live and after restart."
  },
  "L6": {
   "cases": [
    "L6-permanent-deletion-erases"
   ],
   "holds": true,
   "statement": "A permanent deletion removes every version of the lineage from the substrate and no byte of their content reaches a public read; the owner still reads tombstoned."
  }
 },
