+++ b/tools/test-run-discovery-self-run.cjs
@@ -0,0 +1,74 @@
+'use strict';
+/* #808 G4b: the public consumer fails closed on unknown review states, unqualified eligibility,
+ * frozen-lane profile claims and unqualified self-run classifications. Offline; no GitHub calls.
+ * Run: node tools/test-run-discovery-self-run.cjs
+ */
+const assert=require('node:assert/strict');
+const d=require('../assets/run-discovery.js');
+const clone=x=>structuredClone(x);
+const RUNS='reports/benchmarks/runs/640-hindsight/subset50/';
+const SELF='reports/benchmarks/self-run-candidates/640-hindsight/full500/';
+const base={
+ schema_version:'1.0.0',authority_effect:'none',run_id:'hs:subset50:session:hindsight_chunks_onnx',
+ benchmark:{id:'longmemeval-s-retrieval',task_profile:'agent-memory-longmemeval-retrieval-currentness-v1:session',
+  input_sha256:'a'.repeat(64),sample_count:50,excluded_count:7,selection_id:'size=50'},
+ system:{id:'hindsight',adapter_revision:'git-blob:'+'c'.repeat(40)},
+ normalized_run:{uri:RUNS+'hindsight-50.json',sha256:'d'.repeat(64)},
+ execution:{exit_code:0},review:{status:'candidate',comparison_eligibility:'not_assessed'}
+};
+const legacyPath=RUNS+'session.hindsight_chunks_onnx.manifest.json';
+assert.deepEqual(d.validateManifest(base,legacyPath),{plane:'session',backend:'hindsight_chunks_onnx'});
+const refuse=(fn,path=legacyPath)=>{const x=clone(base);fn(x);assert.throws(()=>d.validateManifest(x,path))};
+// Unknown or non-v1 review states, including the previously allowed non-v1 values.
+for(const status of ['reproduced','reviewed','accepted','rejected','blocked','','Candidate',null,undefined])
+ refuse(x=>{x.review.status=status});
+// Unqualified eligibility strings, including the v1 value that implies acceptance.
+for(const eligibility of ['eligible_on_profile','accepted','eligible','',null,undefined,'NOT_ASSESSED'])
+ refuse(x=>{x.review.comparison_eligibility=eligibility});
+refuse(x=>{delete x.review.comparison_eligibility});
+// Any segment naming a frozen lane is refused.
+for(const profile of ['longmemeval-s-retrieval-parity-v1:session','self-run:longmemeval-s-retrieval-parity-v6:session',
+                      'amb-precisionmembench-retrieval-v3:single-turn:session','LongMemEval-S-Retrieval-Parity-V1:session',
+                      ' longmemeval-s-retrieval-parity-v1:session','longmemeval-s-retrieval-parity-v1 :session',
+                      'longmemeval-s-retrieval-parity-v1\u200b:session','\uff4congmemeval-s-retrieval-parity-v1:session'])
+ refuse(x=>{x.benchmark.task_profile=profile});
+refuse(x=>{x.run_id='longmemeval-s-retrieval-parity-v1:session:hindsight_chunks_onnx'});
+// Self-run records: location, prefix and class rules.
+const selfRun=clone(base);
+selfRun.run_id='self-run:640-hindsight:full500:session:hindsight_chunks_onnx';
+selfRun.benchmark.task_profile='self-run:agent-memory-longmemeval-retrieval-currentness-v1:session';
+selfRun.normalized_run.uri='reports/benchmarks/runs/640-hindsight/full500/session.hindsight_chunks_onnx.summary.json';
+selfRun.inference={used:true,calls:[{purpose:'embedding',endpoint_class:'local'}]};
+selfRun.candidate_class={class:'self_run_candidate',tier:'local_embedding_model',
+ system_variant:'Hindsight 0.10.2 chunk-only (llm_provider=none)',not_equivalent_to:['Hindsight LLM product']};
+const selfPath=SELF+'session.hindsight_chunks_onnx.manifest.json';
+assert.deepEqual(d.validateManifest(selfRun,selfPath),{plane:'session',backend:'hindsight_chunks_onnx'});
+const refuseSelf=fn=>{const x=clone(selfRun);fn(x);assert.throws(()=>d.validateManifest(x,selfPath))};
+refuseSelf(x=>{x.candidate_class.class='official'});
+refuseSelf(x=>{x.candidate_class.tier='frontier'});
+refuseSelf(x=>{x.candidate_class.tier='no_model'});                         // tier must match the recorded calls
+refuseSelf(x=>{x.inference.calls[0].endpoint_class='hosted'});
+refuseSelf(x=>{x.inference.calls[0].purpose='generation'});
+refuseSelf(x=>{delete x.inference});
+refuseSelf(x=>{x.candidate_class.system_variant=''});
+refuseSelf(x=>{x.candidate_class=null});
+refuseSelf(x=>{x.run_id='640-hindsight:full500:session:hindsight_chunks_onnx'});
+refuseSelf(x=>{x.benchmark.task_profile='agent-memory-longmemeval-retrieval-currentness-v1:session'});
+refuseSelf(x=>{x.candidate_class.class='self_run_diagnostic'});            // diagnostic must be not_comparable
+refuseSelf(x=>{delete x.candidate_class});                                   // self-run location requires the class
+const diag=clone(selfRun);diag.candidate_class.class='self_run_diagnostic';diag.review.comparison_eligibility='not_comparable';
+d.validateManifest(diag,selfPath);
+// Source allowlist accepts the isolated self-run prefix but nothing else new.
+const sources={schema_version:1,kind:'public-candidate-manifest-sources',authority_effect:'none',
+ repository:'MythologIQ-Labs-LLC/agent-memory',read_only:true,sources:[
+ {branch:'claude/810-external-exec-no-ci',prefix:'reports/benchmarks/self-run-candidates/',max_manifest_files:48,max_partial_files:0}]};
+assert.equal(d.validateSources(sources).length,1);
+sources.sources[0].prefix='reports/benchmarks/normalized/';assert.throws(()=>d.validateSources(sources));
+// Rows carry the class and tier; a full-500 cohort is labelled full.
+const full=clone(selfRun);full.benchmark.sample_count=500;full.benchmark.excluded_count=81;
+full.benchmark.selection_id='all-500:'+'7'.repeat(64);
+const row=d.createRow(full,selfPath,'e'.repeat(40),{plane:'session',backend:'hindsight_chunks_onnx'},null,'withheld');
+assert.equal(row.cohort,'500 input · full');
+assert.match(row.review,/self run candidate · local embedding model/);
+assert.equal(row.score,null);
+console.log('PASS: unknown review states, unqualified eligibility, frozen-lane labels and unqualified self-run classes fail closed; isolated self-run prefix; class/tier labelling');
