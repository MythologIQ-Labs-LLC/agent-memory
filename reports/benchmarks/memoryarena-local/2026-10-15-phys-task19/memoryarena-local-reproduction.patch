new file mode 100644
index 0000000..ac5bfc6
--- /dev/null
+++ b/memory/memory_systems/none.py
@@ -0,0 +1,12 @@
+class NoMemorySystem:
+    """Memory-disabled baseline: stores nothing and wraps every prompt exactly as an empty
+    long_context memory does, so the two arms differ only in remembered content."""
+
+    def __init__(self, user_id=None):
+        self.user_id = user_id
+
+    def add_chunk(self, chunk: str):
+        return None
+
+    def wrap_user_prompt(self, prompt: str) -> str:
+        return "\n".join(["<memory_context>", "None", "</memory_context>", f"User: {prompt}"])
