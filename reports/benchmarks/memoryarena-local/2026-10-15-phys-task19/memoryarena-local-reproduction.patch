diff --git a/memory/memory_systems/agent_memory.py b/memory/memory_systems/agent_memory.py
new file mode 100644
index 0000000..5511ad9
--- /dev/null
+++ b/memory/memory_systems/agent_memory.py
@@ -0,0 +1,47 @@
+"""Agent Memory (github.com/MythologIQ-Labs-LLC/agent-memory) as a MemoryArena memory system.
+
+Mirrors the harness's RAG memory system (same <memory> formatting, same top_k=3) but stores
+and recalls through the public AgentMemory facade: each add_chunk is one governed
+``remember``; wrap_user_prompt is one ``recall(prompt, budget=top_k)`` returning the runtime's
+ranked prefix. One durable runtime per MemoryArena user (task) under a temporary directory.
+"""
+
+import hashlib
+import tempfile
+from typing import Optional
+
+from agentmem_ref import AgentMemory
+
+
+class AgentMemoryMemorySystem:
+    def __init__(self, top_k: int = 3, user_id: Optional[str] = None):
+        self.top_k = top_k
+        self.user_id = user_id
+        self._dir = tempfile.TemporaryDirectory(prefix="memoryarena-agent-memory-")
+        self._memory = AgentMemory.open(self._dir.name, scope="memoryarena:task", purpose="MemoryArena task memory")
+        self._texts: dict[str, str] = {}
+        self._count = 0
+
+    def add_chunk(self, chunk: str):
+        if not chunk.strip():
+            return None
+        reference = "memoryarena:chunk:" + hashlib.sha256(f"{self._count}\x00{chunk}".encode("utf-8")).hexdigest()
+        outcome = self._memory.remember(reference, chunk)
+        if not outcome.get("committed"):
+            raise RuntimeError(f"Agent Memory refused a chunk: {outcome.get('refusal') or outcome.get('outcome')}")
+        self._texts[str(outcome["fact_uuid"])] = chunk
+        self._count += 1
+        return {"fact_uuid": outcome["fact_uuid"]}
+
+    def wrap_user_prompt(self, prompt: str) -> str:
+        lines = ["<memory_context>"]
+        returned = []
+        if self._texts:
+            returned = [str(item) for item in self._memory.recall(prompt, budget=self.top_k).get("returned") or []]
+        if returned:
+            lines.extend(f"<memory>{self._texts[fact]}</memory>" for fact in returned)
+        else:
+            lines.append("None")
+        lines.append("</memory_context>")
+        lines.append(f"User: {prompt}")
+        return "\n".join(lines)
