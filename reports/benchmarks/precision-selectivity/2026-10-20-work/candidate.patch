+"""Experimental lexical content terms; never admission or truth authority.
+
+This unqualified candidate removes closed-class English grammatical terms only.
+Negation remains evidence. It does not infer names, scope, or currentness.
+"""
+
+POLICY_ID = "lexical-content-terms-experiment"
+POLICY_VERSION = "0.1.0"
+GRAMMATICAL_TERMS = frozenset(
+    "a an the and or but if in on at of to for from with by as is are was were "
+    "be been being do does did have has had how what when where which who whom whose".split()
+)
+
+
+def content_terms(text: str) -> set[str]:
+    return {
+        token.strip(".,;:!?").lower()
+        for token in text.split()
+        if token.strip(".,;:!?")
+    } - GRAMMATICAL_TERMS
