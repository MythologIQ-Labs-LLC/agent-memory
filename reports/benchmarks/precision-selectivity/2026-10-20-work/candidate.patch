+import unittest, tempfile
+from agentmem_ref import AgentMemory
+class CandidateTests(unittest.TestCase):
+ def test_grammatical_overlap_alone_is_not_task_context(self):
+  with tempfile.TemporaryDirectory() as root:
+   with AgentMemory.open(root,tenant='t',actor_id='a',scope='s',purpose='retrieval quality') as m:
+    wanted=m.remember('m:camera','The streaming camera uses a wide angle lens.')['fact_uuid']
+    unrelated=m.remember('m:printer','The printer uses recycled paper.')['fact_uuid']
+    result=m.recall('What is the streaming camera?')
+    self.assertIn(wanted,result['returned'])
+    self.assertNotIn(unrelated,result['returned'])
+if __name__=='__main__':unittest.main()
