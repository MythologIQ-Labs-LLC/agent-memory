  "contract": {
    "query_is_never_globally_rewritten": true,
    "ordinary_candidates_keep_full_bm25": true,
    "suppression_is_candidate_specific": true,
    "eligible_query_terms": "A normalized BM25 term is eligible only when every occurrence of that term in the original query lies wholly inside a consumed temporal-intent span that contributes to the resolved, temporally-ordering query intent. Declined spans and mixed content occurrences keep the term lexical.",
    "eligible_candidate": "A candidate is eligible only when persisted write semantics contain a high-risk untrusted self-claim marker: currentness, supersession, or instruction. Authority or verification markers alone are insufficient because words such as official and verified can be ordinary content.",
    "suppression_effect": "For an eligible candidate only, eligible temporal query terms contribute zero candidate term frequency to BM25. Admitted-set document frequency, average document length, candidate text, and every other query term remain unchanged.",
    "no_temporal_bonus": true,
    "no_currentness_invention": true,
    "no_authority_effect": true,
    "no_admission_change": true,
    "sorted_term_accumulation_preserved": true,
    "historical_facts_not_reinterpreted": true
  },
  "high_risk_self_claim_markers": [
    "currentness",
    "instruction",
    "supersession"
  ],
