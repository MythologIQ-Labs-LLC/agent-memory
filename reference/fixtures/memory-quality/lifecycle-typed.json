  {
   "id": "typed-residence",
   "category": "typed_state_change",
   "description": "state, then a later typed change in different words",
   "operations": [
    {
     "op": "remember",
     "scope": "project:life",
     "ref": "memory:residence-old",
     "text": "I live in Boston with my partner.",
     "observed_at": "2025-01-10",
     "source_ref": "user:owner",
     "proposition": {
      "subject": "user",
      "attribute": "residence",
      "value": "Boston",
      "assertion": "state",
      "cardinality": "single"
     }
    },
    {
     "op": "remember",
     "scope": "project:life",
     "ref": "memory:residence-new",
     "text": "My partner and I moved to Denver in June.",
     "observed_at": "2025-07-02",
     "source_ref": "user:owner",
     "proposition": {
      "subject": "user",
      "attribute": "residence",
      "value": "Denver",
      "assertion": "change",
      "cardinality": "single",
      "replaces_value": "Boston"
     }
    },
    {
     "op": "remember",
     "scope": "project:life",
     "ref": "memory:residence-noise",
     "text": "Bought groceries and paid the electricity bill.",
     "observed_at": "2025-07-05",
     "source_ref": "user:owner"
    }
   ],
   "queries": [
    {
     "id": "q-residence",
     "scope": "project:life",
     "query": "Where do I live these days?",
     "expect": {
      "must_include": [
       "memory:residence-new"
      ],
      "may_include": [
       "memory:residence-old"
      ]
     }
    }
   ]
  },
