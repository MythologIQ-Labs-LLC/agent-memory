 "invariants": [
  {
   "id": "R1",
   "statement": "The owner of a governed-deleted memory reads tombstoned, no current fact, no events, no rejected values, the version its deletion recorded, and no identifier or text of the deleted generation, live and after restart.",
   "falsified_by": "any identifier, text, event or rejected value, or a different version"
  },
  {
   "id": "R2",
   "statement": "Another project reads the deleted memory byte-identically (ids and timestamps folded) to an id nobody wrote: history, a value probe, recall by logical reference, and historical recall, live and after restart.",
   "falsified_by": "any difference from the unknown-id result"
  },
  {
   "id": "R3",
   "statement": "The owner's deleted view does not change when another project re-creates, corrects and deletes the same id.",
   "falsified_by": "any field of the owner's view changing"
  },
  {
   "id": "R4",
   "statement": "A memory derived from a deleted fact is withheld from public recall while a live derivation keeps its provenance.",
   "falsified_by": "the derived-from-deleted memory or the deleted fact surfacing, or the live derivation lost"
  },
  {
   "id": "R5",
   "statement": "A re-created generation's public history carries only its own events; another scope's refused attempt leaves no trace in it.",
   "falsified_by": "an event from the former generation or from a refused attempt"
  },
  {
   "id": "R6",
   "statement": "The receipts and history of a new generation never carry the former generation's version count.",
   "falsified_by": "a before_state, after_state, snapshot or history version continuing the former count"
  }
 ],
