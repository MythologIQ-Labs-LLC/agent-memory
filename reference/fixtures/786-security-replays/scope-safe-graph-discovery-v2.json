  {
   "id": "I1",
   "statement": "A seed the reader is not eligible to inspect, or whose identifier the reader's view withholds, expands nothing: no route hit, no reported path, no candidate.",
   "falsified_by": "any candidate or reported path discovered from such a seed"
  },
  {
   "id": "I2",
   "statement": "A neighbour outside the reader's eligibility is never a caller-visible candidate, never reported, and never counted.",
   "falsified_by": "an other-project neighbour in candidates, reported hits or the graph route count"
  },
  {
   "id": "I3",
   "statement": "A multi-hop route never reaches an eligible fact by traversing an ineligible node.",
   "falsified_by": "a candidate reachable only through an other-project intermediate"
  },
  {
   "id": "I4",
   "statement": "Route budgets (graph fan-out, exact-identity quota) are spent on eligible paths and references only, so leading ineligible ones cannot starve eligible ones.",
   "falsified_by": "an eligible neighbour or reference lost while ineligible ones occupied the budget"
  },
  {
   "id": "I5",
   "statement": "A neighbour the reader legitimately holds through a shared isolation domain stays discoverable and admitted.",
   "falsified_by": "the shared-domain neighbour missing from admitted"
  },
  {
   "id": "I6",
   "statement": "A deleted generation confers no reachability: it is never reported, never traversed through, and never expanded as a seed.",
   "falsified_by": "a candidate reachable only through, or from, a deleted or withheld node, or a deleted node in a reported path"
  },
  {
   "id": "I7",
   "statement": "With no relations the graph route discovers nothing and the seed is served by its own route.",
   "falsified_by": "a graph candidate without a relation, or the seed missing"
  },
  {
   "id": "I8",
   "statement": "Canonical admission and its internal audit are unchanged: a deleted node that is a direct neighbour may still be a canonical candidate that admission refuses with its recorded reason.",
   "falsified_by": "the direct deleted neighbour missing from canonical candidates or its refusal reason changed"
  }
 ],
