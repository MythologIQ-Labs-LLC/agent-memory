  }
 ],
 "invariants": [
  {
   "id": "W1",
   "statement": "A promotion from another project onto a live head is refused with target_unavailable, reports v0/v0 and a v0 snapshot, and leaves head, version, recall and history of the owner byte-identical.",
   "falsified_by": "a commit, any other refusal token, a non-v0 state, or any owner-side change"
  },
  {
   "id": "W2",
   "statement": "correct, forget, permanent forget and dispute from another project read byte-identically (ids and timestamps folded) to the same call on an id nobody wrote, and change nothing.",
   "falsified_by": "any difference from the unknown-id result, a tombstone, a dispute mark or an invalidated head"
  },
  {
   "id": "W3",
   "statement": "The refusal holds after every restart; the scope binding is durable.",
   "falsified_by": "a commit after a reopen"
  },
  {
   "id": "W4",
   "statement": "An override leaving required isolation domains outside the bound domains is a malformed proposal (ValueError) for any target; an override declaring a superset of domains plus the owner's project cannot replace or correct the head.",
   "falsified_by": "a result instead of ValueError, a ValueError that differs by target, or a commit under the superset override"
  },
  {
   "id": "W5",
   "statement": "The owner's own remember, correct and dispute stay admitted (a disputed head is recorded as disputed and, as documented, withheld from the owner's own admission), and the same text in an unrelated memory of another project is independent.",
   "falsified_by": "an owner operation refused, or either project's recall admitting the other's fact"
  },
  {
   "id": "W6",
   "statement": "A proposal refused for its target, and one parked by policy review, persist no episode, live and after restart; a committed proposal keeps its episode.",
   "falsified_by": "an episode retrievable after a refusal or review park, or absent after a commit"
  },
  {
   "id": "W7",
   "statement": "A refused attempt by another project leaves no event in the owner's public history, and the other project's history of the memory stays blank.",
   "falsified_by": "any extra event in the owner's history or a non-blank view for the other project"
  },
  {
   "id": "W8",
   "statement": "A re-created generation of a governed-deleted id starts its own version counter (snapshot v0, before v0, after v1, history 1) and the former owner's view keeps the version its deletion recorded and cannot write the id back while the new generation is live.",
   "falsified_by": "the former count in the re-creating writer's receipt or history, a changed former-owner view, or a former-owner write admitted"
  }
 ],
