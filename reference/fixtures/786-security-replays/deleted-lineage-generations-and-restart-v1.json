 "development_history": "Executed once with --allow-dirty before freezing. 21 of 22 cases held as written. One expectation was corrected before the freeze, not after: W5 expected the owner's recall to admit a head the owner had just disputed; docs/44 records that a disputed fact is withheld from admission, so the expectation now requires the disputed mark and an empty admission. No runtime change was motivated by the run.",
 "base_commit": "dd4677890afa15d2a7462c3ebc0270e571b52de3",
 "independence": "Expected outcomes were written from the contract documents listed in contract_sources by the session that implemented the #786 repair, before this fixture was first executed by the runner. They are therefore preregistered but not independent of the implementer; an independent reviewer must read them against the contracts before any acceptance. A failing expectation is a finding, never a reason to edit this fixture; a corrected expectation requires a superseding fixture version with a recorded reason. No frozen holdout phrase or #644 fixture vocabulary is used.",
 "stop_lines": [
  "no fixture edit after first execution; supersede with -v2 and record why",
  "no expectation weakened to obtain PASS",
  "no runtime change motivated by a replay outcome without a preregistered reproducer",
  "a replay verdict is evidence, not successor acceptance; acceptance requires independent review"
 ],
 "title": "A governed deletion withholds its whole generation; re-creation is a fresh, isolated generation; deleted versions are as-of barriers",
 "contract_sources": [
  {
   "path": "docs/774-776-lineage-integration-contract.md",
   "sha256_at_base": "d6c5ba694e75da1f761eb000e2f17842c9a25dff7baedb17425cbfbf1c814e10"
  },
  {
   "path": "docs/774-strict-successor-target-policy.md",
   "sha256_at_base": "fe910667ffa9769d67d5b4faeb68d824ce31cb7951755288b3e3379a01ecd7be"
  },
  {
   "path": "docs/786-cross-scope-write-authority.md",
   "sha256_at_base": "7ef724ee922686b3f2be0d8249109f7e0fa8be8f45bde5a429d33e63ee2ebee3"
  }
 ],
 "invariants": [
  {
   "id": "L1",
   "statement": "After a governed deletion no version of the deleted generation is admitted to current or historical recall, nor by logical reference, and the owner's history reads tombstoned with no events, live and after restart.",
   "falsified_by": "any deleted version admitted or any event served"
  },
  {
   "id": "L2",
   "statement": "The owner's re-creation is visible only as its own generation: old versions are withheld from recall, history and write_semantics while their content stays recoverable after a pruning.",
   "falsified_by": "an old version or its text surfacing, or the old fact physically gone after a pruning"
  },
  {
   "id": "L3",
   "statement": "Another project's re-creation is isolated both ways: the former owner reads nothing of it and cannot write, correct, delete or dispute it; the new generation reads nothing of the former.",
   "falsified_by": "any cross-generation read or an admitted former-owner write"
  },
  {
   "id": "L4",
   "statement": "Every deleted version is an as-of barrier for every reader, and a live generation resolves only for its owner, only from its own start.",
   "falsified_by": "version_in_effect resolving a deleted version, or resolving the live generation for a non-owner"
  },
  {
   "id": "L5",
   "statement": "A governed deletion of one superseded version withholds only that version.",
   "falsified_by": "the deleted version admitted, or a sibling version withheld"
  },
  {
   "id": "L6",
   "statement": "A permanent deletion removes every version of the lineage from the substrate and no byte of their content reaches a public read; the owner still reads tombstoned.",
   "falsified_by": "a surviving fact, a surviving byte of content, or a non-tombstoned owner view"
  }
 ],
