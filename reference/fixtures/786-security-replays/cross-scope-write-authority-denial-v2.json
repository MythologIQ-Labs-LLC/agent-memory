  }
 ],
 "invariants": [
  {
   "id": "W1",
   "statement": "A promotion from another project onto a live head is refused with target_unavailable, reports v0/v0 and a v0 snapshot, and leaves head, version, recall and history of the owner byte-identical.",
   "falsified_by": "a commit, any other refusal token, a non-v0 state, or any owner-side change"
  },
  {
   "id": "W2",
   "statement": "correct, forget, permanent forget and dispute from another project read byte-identically (ids and timestamps folded) to the same call on an id nobody wrote, and change nothing.",
   "falsified_by": "any difference from the unknown-id result, a tombstone, a dispute mark or an invalidated head"
  },
  {
   "id": "W3",
   "statement": "The refusal holds after every restart; the scope binding is durable.",
   "falsified_by": "a commit after a reopen"
  },
  {
   "id": "W4",
   "statement": "An override leaving required isolation domains outside the bound domains is a malformed proposal (ValueError) for any target; an override declaring a superset of domains plus the owner's project cannot replace or correct the head, while (documented) it may delete or dispute it as an eligible reader, and a complete re-declaration of the owner's scope commits as the owner would (the facade is a host-bound trust boundary).",
   "falsified_by": "a result instead of ValueError, a ValueError that differs by target, a commit of remember/correct under the superset override, or a documented disposition silently changing"
  },
  {
   "id": "W5",
   "statement": "The owner's own remember, correct and dispute stay admitted (a disputed head is recorded as disputed and, as documented, withheld from the owner's own admission), and the same text in an unrelated memory of another project is independent.",
   "falsified_by": "an owner operation refused, or either project's recall admitting the other's fact"
  },
  {
   "id": "W6",
   "statement": "A proposal refused for its target, and one parked by policy review, persist no episode, live and after restart; a committed proposal keeps its episode.",
   "falsified_by": "an episode retrievable after a refusal or review park, or absent after a commit"
  },
  {
   "id": "W7",
   "statement": "A refused remember, correct, forget or dispute attempt by another project, and a former owner's attempts on a re-created id, leave no event in the live generation's public history; the refused project's history of the memory stays blank.",
   "falsified_by": "any extra event in the live generation's history or a non-blank view for the refused project"
  },
  {
   "id": "W8",
   "statement": "A governed-deleted id reports 0 to any writer: a re-created generation starts its own counter (snapshot v0, before v0, after v1, history 1), a refused or policy-parked proposal on the tombstoned id reports v0/v0, and the former owner's view keeps the version its deletion recorded and cannot write, dispute or re-delete the id while the new generation is live.",
   "falsified_by": "the former count in any writer's receipt, snapshot or history, a changed former-owner view, or a former-owner act admitted"
  }
 ],
