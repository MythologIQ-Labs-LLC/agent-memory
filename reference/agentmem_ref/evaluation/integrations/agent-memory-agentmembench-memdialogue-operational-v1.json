{
  "contract_family": "agent-memory-benchmark-integration",
  "contract_version": "1.0.0",
  "integration_id": "agent-memory-agentmembench-memdialogue-operational-v1",
  "admission_state": "evidence_partial",
  "owning_issue": 517,
  "description": "AgentMemBench MemDialogue operational phases (write, exact-source retrieval, conflict/currentness, isolation, deletion, concurrency, scale) with no-memory, lexical-overlap, and governed Agent Memory arms at upstream defaults. The upstream LLM-judged recall and M6 portability phases are not run.",
  "benchmark": {
    "id": "agentmembench-memdialogue",
    "name": "AgentMemBench / MemDialogue v2",
    "provenance_class": "external_adapted",
    "upstream": {
      "repository": "mazaiying/AgentMemBench",
      "url": "https://github.com/mazaiying/AgentMemBench",
      "paper_url": null
    },
    "source_revision": "186c9a54edd47aae42d8b6990520f8e902b60303",
    "source_revision_rule": "static_exact_revision"
  },
  "source_rights": {
    "license_spdx": "MIT",
    "license_url": "https://github.com/mazaiying/AgentMemBench/blob/186c9a54edd47aae42d8b6990520f8e902b60303/LICENSE",
    "data_license_spdx": "ODC-By-1.0",
    "code_redistribution": "linked_only",
    "data_redistribution": "linked_only",
    "attribution": "MemDialogue is derived from WildChat-4.8M by the Allen Institute for AI; harness semantics follow agentmembench/evaluation/unified_benchmark.py (sha256 d0d407129aa506f6eacbf6df19a26c1a9ddd000aa0bfb931cb4e4ae984e594df)",
    "acquisition_notes": "Operators obtain data/memdialogue_v2.jsonl from the pinned upstream revision; the runner hashes the raw file and records whether it matches the upstream release digest."
  },
  "input_contract": {
    "dataset_id": "mazaiying/AgentMemBench:data/memdialogue_v2.jsonl",
    "dataset_revision_rule": "exact_revision_required",
    "known_dataset_revision": "mazaiying/AgentMemBench@186c9a54edd47aae42d8b6990520f8e902b60303",
    "input_digest_rule": "sha256_raw_file_bytes",
    "known_input_sha256": "33632710ae6495b95724df455ff6f9947d231ee68ebc0ef10eb8291fd55ca2a6",
    "committed_input_path": null,
    "input_may_be_absent_before_execution": true,
    "corpus_classes": [
      "synthetic",
      "external_frozen"
    ],
    "selection": {
      "identity_rule": "input.selection.source_ids_sha256 = sha256 of newline-joined selected source ids",
      "methods": [
        "upstream load_records: source-unique, event-type-stratified, numpy default_rng(seed)"
      ]
    }
  },
  "native_protocol": {
    "task_type": "operational_memory_phases",
    "native_metrics": [
      {
        "metric_id": "exact_source_recall_at_k",
        "description": "retrieval phase, with bootstrap CI; profile-local deterministic replacement for the upstream LLM-judged recall",
        "direction": "higher_better",
        "upstream_defined": false
      },
      {
        "metric_id": "write_success_rate",
        "description": "retrieval and scale phases",
        "direction": "higher_better",
        "upstream_defined": true
      },
      {
        "metric_id": "new_fact_rate / staleness_rate / dual_version_rate",
        "description": "conflict phase, top-1 over independent old/new write pairs",
        "direction": "descriptive",
        "upstream_defined": true
      },
      {
        "metric_id": "cross_user_leak_rate",
        "description": "isolation phase canary queries",
        "direction": "zero_target",
        "upstream_defined": true
      },
      {
        "metric_id": "pre_delete_visibility_rate / post_delete_absence_rate / audited_deletion_rate",
        "description": "deletion phase",
        "direction": "descriptive",
        "upstream_defined": true
      },
      {
        "metric_id": "operation_success_rate / throughput_ops_s",
        "description": "concurrency phase per worker count",
        "direction": "descriptive",
        "upstream_defined": true
      },
      {
        "metric_id": "recall_at_3 / latency",
        "description": "scale phase per stored-fact count",
        "direction": "descriptive",
        "upstream_defined": true
      }
    ],
    "native_artifacts": [
      {
        "artifact_id": "native-report",
        "kind": "benchmark_native_results",
        "description": "backends[backend].phases with phase_errors, governance tallies, and parameters"
      },
      {
        "artifact_id": "normalized-runs",
        "kind": "memory_benchmark_run",
        "description": "one common manifest per backend"
      }
    ],
    "runner": {
      "kind": "repository_script",
      "entry_point": "reference/run_agentmembench.py",
      "supporting_entry_points": [],
      "invocation_example": "python reference/run_agentmembench.py --input <memdialogue_v2.jsonl> --corpus-class external_frozen --output report.json"
    },
    "budget": {
      "retrieval_or_context_budget": "top-k 5 at upstream defaults; phase sizes per upstream defaults",
      "parameters": {
        "top_k": 5,
        "retrieval_records": 1000,
        "conflict_pairs": 250,
        "isolation_users": 100,
        "deletion_records": 200,
        "concurrency_records": 200,
        "workers": [
          1,
          4,
          8,
          16
        ],
        "scales": [
          100,
          1000
        ]
      }
    },
    "failure_semantics": {
      "per_item_error_capture": false,
      "timeout": "none",
      "description": "each phase runs under its own error capture (phase_errors); a failed phase makes the normalized run partial; concurrency-phase write exceptions are counted per worker count"
    },
    "concurrency": "sequential phases; the concurrency phase uses ThreadPoolExecutor at the declared worker counts"
  },
  "system_requirements": {
    "invocation_surface": "upstream_adapter_protocol",
    "external_system_entry": "code_registration",
    "required_operations": [
      "reset",
      "add",
      "search",
      "delete",
      "close"
    ],
    "optional_operations": [],
    "unsupported_semantics": "a backend without deletion or isolation semantics is scored by the native protocol for those phases; the Agent Memory arm reports governed tombstone deletion rather than physical deletion"
  },
  "provider_requirements": {
    "credentials": "credential_free",
    "model_dependency": "none",
    "judge": {
      "required": false,
      "identity": null,
      "note": "upstream LLM-judged retrieval recall is not run; no judge endpoint is provisioned"
    },
    "python_dependencies": [
      "numpy"
    ]
  },
  "normalization": {
    "normalizer": "agentmem_ref.evaluation.normalize:normalize_agentmembench",
    "mappings": [
      {
        "dimension": "retrieval",
        "metric_id": "exact_source_recall_at_5",
        "native_evidence": "backends.<backend>.phases.retrieval.exact_source_recall_at_k",
        "semantics": "stratified source-unique records, 10 per user group; profile-local deterministic metric",
        "direction": "higher_better"
      },
      {
        "dimension": "retrieval",
        "metric_id": "exact_source_recall_at_5_<event_type>",
        "native_evidence": "backends.<backend>.phases.retrieval.exact_source_recall_by_event_type.<event_type>",
        "semantics": "per upstream event type",
        "direction": "higher_better"
      },
      {
        "dimension": "retrieval",
        "metric_id": "write_success_rate",
        "native_evidence": "backends.<backend>.phases.retrieval.write_success_rate",
        "semantics": "retrieval-phase writes",
        "direction": "higher_better"
      },
      {
        "dimension": "retrieval",
        "metric_id": "upstream_llm_judged_recall_at_k",
        "native_evidence": "backends.<backend>.phases.retrieval.upstream_llm_judged_recall_at_k",
        "semantics": "declared not_measured: no judge endpoint provisioned",
        "direction": "higher_better"
      },
      {
        "dimension": "currentness",
        "metric_id": "new_fact_rate",
        "native_evidence": "backends.<backend>.phases.conflict.new_fact_rate",
        "semantics": "independent old/new write pairs, top-1",
        "direction": "higher_better"
      },
      {
        "dimension": "currentness",
        "metric_id": "staleness_rate",
        "native_evidence": "backends.<backend>.phases.conflict.staleness_rate",
        "semantics": "independent old/new write pairs, top-1",
        "direction": "lower_better"
      },
      {
        "dimension": "currentness",
        "metric_id": "dual_version_rate",
        "native_evidence": "backends.<backend>.phases.conflict.dual_version_rate",
        "semantics": "independent old/new write pairs, top-1",
        "direction": "descriptive"
      },
      {
        "dimension": "governance",
        "metric_id": "cross_user_leak_rate",
        "native_evidence": "backends.<backend>.phases.isolation.cross_user_leak_rate",
        "semantics": "cross-user canary queries",
        "direction": "zero_target"
      },
      {
        "dimension": "governance",
        "metric_id": "audited_deletion_rate",
        "native_evidence": "backends.<backend>.phases.deletion.audited_deletion_rate",
        "semantics": "deletion canaries visible before delete; not_applicable when nothing was visible before deletion",
        "direction": "higher_better"
      },
      {
        "dimension": "efficiency",
        "metric_id": "retrieval_write_latency_mean_ms",
        "native_evidence": "backends.<backend>.phases.retrieval.write_latency.mean_ms",
        "semantics": "local in-process latency; not comparable to upstream service-backed latency",
        "direction": "lower_better"
      },
      {
        "dimension": "efficiency",
        "metric_id": "retrieval_read_latency_mean_ms",
        "native_evidence": "backends.<backend>.phases.retrieval.read_latency.mean_ms",
        "semantics": "local in-process latency",
        "direction": "lower_better"
      },
      {
        "dimension": "efficiency",
        "metric_id": "retrieval_read_latency_p95_ms",
        "native_evidence": "backends.<backend>.phases.retrieval.read_latency.p95_ms",
        "semantics": "local in-process latency",
        "direction": "lower_better"
      },
      {
        "dimension": "efficiency",
        "metric_id": "scale_<scale>_recall_at_3",
        "native_evidence": "backends.<backend>.phases.scale.<scale>.recall_at_3",
        "semantics": "per stored-fact count",
        "direction": "higher_better"
      },
      {
        "dimension": "efficiency",
        "metric_id": "scale_<scale>_write_latency_mean_ms",
        "native_evidence": "backends.<backend>.phases.scale.<scale>.write_latency.mean_ms",
        "semantics": "per stored-fact count",
        "direction": "lower_better"
      },
      {
        "dimension": "efficiency",
        "metric_id": "scale_<scale>_read_latency_mean_ms",
        "native_evidence": "backends.<backend>.phases.scale.<scale>.read_latency.mean_ms",
        "semantics": "per stored-fact count",
        "direction": "lower_better"
      },
      {
        "dimension": "efficiency",
        "metric_id": "concurrency_<workers>_operation_success_rate",
        "native_evidence": "backends.<backend>.phases.concurrency.<workers>.operation_success_rate",
        "semantics": "per worker count",
        "direction": "higher_better"
      },
      {
        "dimension": "efficiency",
        "metric_id": "peak_rss_mb",
        "native_evidence": "execution.resource_consumption.peak_rss_mb_process",
        "semantics": "whole process; measured only when the report ran exactly one backend, otherwise not_measured",
        "direction": "lower_better"
      },
      {
        "dimension": "reproducibility",
        "metric_id": "input_sha256_bound",
        "native_evidence": "input.sha256",
        "semantics": "exact raw-byte input digest present",
        "direction": "descriptive"
      },
      {
        "dimension": "reproducibility",
        "metric_id": "input_matches_upstream_release",
        "native_evidence": "input.matches_upstream_release",
        "semantics": "raw digest equals the pinned upstream release digest",
        "direction": "descriptive"
      },
      {
        "dimension": "reproducibility",
        "metric_id": "agent_memory_worktree_clean",
        "native_evidence": "execution.agent_memory_worktree_dirty",
        "semantics": "false or unknown means the run cannot be bound to an exact committed tree",
        "direction": "descriptive"
      }
    ],
    "unmapped_dimensions": {
      "reasoning": "not_measured: no answer-generation or LLM-judged phase was run",
      "evaluator_integrity": "not_measured: evaluator-integrity mutation probes run separately (reference/run_benchmark_integrity_mutants.py, #518) and are not bound to a run"
    }
  },
  "evaluator_integrity": {
    "negative_controls": [
      {
        "control_id": "stale_over_current",
        "description": "adapter returns stale write first; staleness_rate must rise",
        "expected_detection": true
      },
      {
        "control_id": "cross_user_leak",
        "description": "adapter leaks across users; cross_user_leak_rate must rise",
        "expected_detection": true
      },
      {
        "control_id": "deletion_ignored",
        "description": "adapter ignores delete; post-delete absence must fall",
        "expected_detection": true
      },
      {
        "control_id": "write_dropped",
        "description": "adapter drops writes; recall must fall",
        "expected_detection": true
      },
      {
        "control_id": "identity_mapping_corruption",
        "description": "adapter corrupts source identity mapping; exact-source recall must fall",
        "expected_detection": true
      }
    ],
    "runner": "reference/run_benchmark_integrity_mutants.py",
    "qualification_expectation": "all_detected must be true; retrieval and concurrency phases are declared not_probed"
  },
  "reproducibility": {
    "seed": {
      "material": true,
      "default": 2027,
      "note": "numpy default_rng(seed) drives stratified sampling and bootstrap CIs"
    },
    "environment_requirements": [
      "python>=3.11",
      "numpy",
      "no network access required once the dataset is present"
    ],
    "artifact_requirements": [
      "native report JSON per backend",
      "normalized memory-benchmark-run manifests"
    ],
    "revision_binding": "execution.agent_memory_revision + execution.agent_memory_worktree_dirty + upstream.revision + upstream.dataset_sha256 + input.sha256 + parameters digest"
  },
  "gauntlet": {
    "relationship": "eligible",
    "profile_id": null,
    "reason": "the upstream five-method adapter protocol (reset/add/search/delete/close) maps onto reset/remember/recall/forget operation envelopes; a Gauntlet profile binding is deferred until a system-neutral runner exists for the same-harness comparator work (#640)"
  },
  "evidence_history": [
    {
      "variant": "memdialogue_v2_upstream_defaults",
      "status": "complete",
