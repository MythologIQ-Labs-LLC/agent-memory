      "report_binding": {
        "input_sha256_path": "input.sha256",
        "system_revision_path": "execution.agent_memory_revision"
      },
      "normalized_reports": [
        "reports/benchmarks/normalized/agentmembench-memdialogue-agent_memory-03197cd5c866.json"
      ],
      "evidence_pr": 533
    },
    {
      "variant": "upstream_llm_judged_retrieval_recall",
      "status": "not_run"
    },
    {
      "variant": "llm_portability_m6",
      "status": "not_run"
    }
  ],
  "product_findings": [
    {
      "issue": 531,
      "summary": "independent newer writes lose to stale writes (staleness 1.00)"
    },
    {
      "issue": 530,
      "summary": "public handle is thread-affine (concurrency success 0.0)"
    },
    {
      "issue": 522,
      "summary": "write and recall latency grow with retained-state and tenant size"
    }
  ],
  "dimensions": [
    "retrieval",
    "currentness",
    "governance",
    "efficiency",
    "reproducibility"
  ],
  "limitations": [
