{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-memory://research/atlas/snapshot-manifest/1.0.0",
  "title": "Agent Memory Atlas Snapshot Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "atlas_repository",
    "atlas_commit",
    "captured_at",
    "git_object_identity",
    "system_report_count",
    "pattern_count",
    "methodology_files",
    "source_digests",
    "generated_site_drift",
    "methodology_limits"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "atlas_repository": { "type": "string", "minLength": 1 },
    "atlas_commit": { "$ref": "#/$defs/gitSha" },
    "captured_at": { "type": "string", "format": "date-time" },
    "git_object_identity": {
      "type": "object",
      "required": ["root_tree_sha", "content_tree_sha", "systems_tree_sha", "patterns_tree_sha", "methodology_tree_sha"],
      "properties": {
        "root_tree_sha": { "$ref": "#/$defs/gitSha" },
        "content_tree_sha": { "$ref": "#/$defs/gitSha" },
        "systems_tree_sha": { "$ref": "#/$defs/gitSha" },
        "patterns_tree_sha": { "$ref": "#/$defs/gitSha" },
        "methodology_tree_sha": { "$ref": "#/$defs/gitSha" }
      },
      "additionalProperties": false
    },
    "system_report_count": { "$ref": "#/$defs/countRecord" },
    "pattern_count": { "$ref": "#/$defs/countRecord" },
    "methodology_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "blob_sha"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "blob_sha": { "$ref": "#/$defs/gitSha" }
        },
        "additionalProperties": false
      }
    },
    "source_digests": { "type": "object", "minProperties": 2 },
    "generated_site_drift": { "type": "object", "minProperties": 1 },
    "methodology_limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "countRecord": {
      "type": "object",
      "required": ["value", "source", "interpretation"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "source_blob_sha": { "$ref": "#/$defs/gitSha" },
        "interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
