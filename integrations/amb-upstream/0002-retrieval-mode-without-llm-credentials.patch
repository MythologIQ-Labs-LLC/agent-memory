From 210a6d3f277f9507eda1c98d5b880f11632ae8cd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 05:16:29 +0000
Subject: [PATCH] fix(cli): run retrieval mode without LLM credentials

`amb run --mode retrieval` scores the returned IDs with no answer model and
no judge, but the CLI still required GEMINI_API_KEY and constructed the
answer client (Groq by default, which raises without GROQ_API_KEY) and the
GeminiJudge (genai.Client(), which raises without a key) up front. A
credential-free PrecisionMemBench run therefore exited before the first
query.

Skip the key check and the answer client in retrieval mode, and build the
default judge on first use. Every other mode behaves as before (rag without
a key still exits with "GEMINI_API_KEY environment variable is not set").
Verified: bm25 on precisionmembench/single-turn with no keys at all gives
8/77, identical case by case to the same run through the unmodified CLI
with placeholder keys.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/memory_bench/cli.py    | 8 ++++++--
 src/memory_bench/runner.py | 4 +++-
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/memory_bench/cli.py b/src/memory_bench/cli.py
index 76d5d27..fa299f7 100644
--- a/src/memory_bench/cli.py
+++ b/src/memory_bench/cli.py
@@ -54,7 +54,11 @@ def run(
     description: str = typer.Option(None, "--description", "-d", help="Optional description for this run (stored in the result JSON)"),
 ) -> None:
     """Run an evaluation on a single split (optionally filtered to a category)."""
-    _resolve_gemini_key()
+    # Retrieval mode scores the returned IDs with no answer model and no judge, so it must not
+    # require (or construct clients for) LLM credentials.
+    needs_llm = mode != "retrieval"
+    if needs_llm:
+        _resolve_gemini_key()
 
     ds = get_dataset(dataset)
 
@@ -66,7 +70,7 @@ def run(
         dataset=ds,
         split=split,
         memory=get_memory_provider(memory),
-        mode=get_mode(mode, llm=get_answer_llm()),
+        mode=get_mode(mode, llm=get_answer_llm() if needs_llm else None),
         category=category,
         query_limit=query_limit,
         query_id=query_id,
diff --git a/src/memory_bench/runner.py b/src/memory_bench/runner.py
index 190bb2b..0160858 100644
--- a/src/memory_bench/runner.py
+++ b/src/memory_bench/runner.py
@@ -39,13 +39,15 @@ def _score_mcq(answer: str, gold_answers: list[str]) -> tuple[bool, str]:
 class EvalRunner:
     def __init__(self, output_dir: Path = Path("outputs")):
         self.output_dir = output_dir
-        self._judge = GeminiJudge()
+        self._judge: GeminiJudge | None = None  # built on first use; retrieval-scored runs never judge
         self._dataset_metrics: dict = {}
 
     def _get_judge(self, dataset: Dataset) -> "GeminiJudge":
         dataset_llm = dataset.default_judge_llm() if hasattr(dataset, "default_judge_llm") else None
         if dataset_llm is not None:
             return GeminiJudge(llm=dataset_llm)
+        if self._judge is None:
+            self._judge = GeminiJudge()
         return self._judge
 
     def run(
-- 
