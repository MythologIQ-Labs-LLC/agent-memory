index 0000000..c734bc3
--- /dev/null
+++ b/src/memory_bench/memory/agent_memory.py
@@ -0,0 +1,140 @@
+"""Agent Memory provider for Agent Memory Benchmark.
+
+Agent Memory (https://github.com/MythologIQ-Labs-LLC/agent-memory) is a governed local memory
+runtime: every write passes a policy decision and commits to a durable single-writer SQLite
+store, and recall runs candidate generation followed by governed admission and ranking. No LLM
+is used at ingestion or retrieval.
+
+Setup:
+  pip install "agent-memory-reference @ git+https://github.com/MythologIQ-Labs-LLC/agent-memory@<commit>"
+
+Each document becomes one memory through the public ``AgentMemory.remember`` API, scoped per
+``user_id`` (a hashed scope inside one runtime store; recall in one scope never sees another).
+``retrieve`` is one ``AgentMemory.recall(query, budget=k)``: the provider returns the runtime's
+ranked ``returned`` prefix as-is, with no re-ranking or truncation of its own.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+from pathlib import Path
+
+from ..models import Document
+from .base import MemoryProvider
+
+_TENANT = "tenant:amb"
+_ACTOR = "agent:amb"
+_PURPOSE = "Agent Memory Benchmark evaluation"
+_INDEX_VERSION = 1
+
+
+def _agent_memory():
+    try:
+        from agentmem_ref import AgentMemory
+    except ImportError as exc:  # pragma: no cover - depends on the optional install
+        raise ImportError(
+            "The agent-memory provider needs the Agent Memory runtime: "
+            'pip install "agent-memory-reference @ git+https://github.com/MythologIQ-Labs-LLC/agent-memory@<commit>"'
+        ) from exc
+    return AgentMemory
+
+
+def _scope(user_id: str | None) -> str:
+    material = "global" if user_id is None else str(user_id)
+    return "amb:scope:" + hashlib.sha256(material.encode("utf-8")).hexdigest()[:32]
+
+
+def _logical_id(document_id: str, user_id: str | None) -> str:
+    material = f"{user_id or 'global'}\x00{document_id}"
+    return "memory:amb:" + hashlib.sha256(material.encode("utf-8")).hexdigest()
+
+
+def _record(document: Document) -> dict:
+    return {
+        "id": str(document.id),
+        "content": str(document.content),
+        "user_id": None if document.user_id is None else str(document.user_id),
+        "timestamp": None if document.timestamp is None else str(document.timestamp),
+        "context": None if document.context is None else str(document.context),
+        "source_ids": list(document.source_ids or [str(document.id)]),
+        "tags": list(document.tags or []),
+    }
+
+
+class AgentMemoryProvider(MemoryProvider):
+    name = "agent-memory"
+    description = (
+        "Agent Memory: governed local memory runtime (policy-checked writes to a durable SQLite "
+        "store; lexical and exact-identity candidate routes, governed admission and ranking). "
+        "No LLM at ingestion or retrieval."
+    )
+    kind = "local"
+    provider = "agent-memory"
+    link = "https://github.com/MythologIQ-Labs-LLC/agent-memory"
+    # One durable single-writer runtime; queries are serialized.
+    concurrency = 1
+
+    def __init__(self) -> None:
+        self._root: Path | None = None
+        self._index_path: Path | None = None
+        self._by_fact: dict[str, dict] = {}
+
+    def prepare(self, store_dir: Path, unit_ids: set[str] | None = None, reset: bool = True) -> None:
+        store_dir = Path(store_dir)
+        self._root = store_dir / "agent-memory-runtime"
+        self._index_path = store_dir / "agent-memory-index.json"
+        if reset:
+            shutil.rmtree(self._root, ignore_errors=True)
+            self._index_path.unlink(missing_ok=True)
+        self._root.mkdir(parents=True, exist_ok=True)
+        self._by_fact = {}
+        if self._index_path.is_file():
+            payload = json.loads(self._index_path.read_text(encoding="utf-8"))
+            if payload.get("version") != _INDEX_VERSION:
+                raise RuntimeError(f"agent-memory index version mismatch in {self._index_path}")
+            self._by_fact = dict(payload["records"])
+
+    def _open(self, user_id: str | None):
+        if self._root is None:
+            raise RuntimeError("agent-memory provider must be prepared before use")
+        return _agent_memory().open(self._root, tenant=_TENANT, actor_id=_ACTOR, scope=_scope(user_id), purpose=_PURPOSE)
+
+    def ingest(self, documents: list[Document]) -> None:
+        by_user: dict[str | None, list[Document]] = {}
+        for document in documents:
+            by_user.setdefault(document.user_id, []).append(document)
+        for user_id, user_documents in by_user.items():
+            with self._open(user_id) as memory:
+                for document in user_documents:
