    {
      "key": "memory:h3:gunnar-sesame",
      "text": "Gunnar breaks out in hives after eating anything containing sesame, including tahini and sesame oil."
    },
    {
      "key": "memory:h3:gunnar-race",
      "text": "Gunnar is training for the Harrowgate half marathon at the end of September."
    },
    {
      "key": "memory:h3:gunnar-car",
      "text": "Gunnar's car is in for repairs at Kestrel Motors this week."
    },
    {
      "key": "memory:h3:kestrel-hours",
      "text": "Kestrel Motors closes at 5:30 p.m. on weekdays and stays shut on Sundays."
    },
    {
      "key": "memory:h3:soledad-ferry",
      "text": "Soledad cycles to the Ashgrove ferry terminal every weekday and catches the 8:05 boat across the bay."
    },
    {
      "key": "memory:h3:soledad-flatmate",
      "text": "Soledad shares a flat with her cousin Dmitri."
    },
    {
      "key": "memory:h3:dmitri-job",
      "text": "Dmitri's job is working night shifts as a paramedic."
    },
    {
      "key": "memory:h3:soledad-bookclub",
      "text": "Soledad's book club is reading The Salt Orchard this month."
    },
    {
      "key": "memory:h3:kwame-job",
      "text": "Kwame works as a lab technician at the Tidewater Seed Bank."
    },
    {
      "key": "memory:h3:tidewater-address",
      "text": "The Tidewater Seed Bank's street address is 41 Quarrystone Road, next to the old tram depot."
    },
    {
      "key": "memory:h3:kwame-coffee",
      "text": "Kwame drinks his coffee black with no sugar."
    },
    {
      "key": "memory:h3:lucan-coffee",
      "text": "Lucan takes his coffee with oat milk and two sugars."
    },
    {
      "key": "memory:h3:lucan-manager",
      "text": "Lucan reports to a manager named Ingrid Halvorsen."
    },
    {
      "key": "memory:h3:ingrid-office",
      "text": "Ingrid Halvorsen's office is on the ninth floor of the Brackwater building."
    },
    {
      "key": "memory:h3:lucan-thermostat",
      "text": "The thermostat in Lucan's flat is set to 19 degrees."
    },
    {
      "key": "memory:h3:azadeh-sister",
      "text": "Azadeh's younger sister is called Nilufar."
    },
    {
      "key": "memory:h3:nilufar-move",
      "text": "Nilufar now lives in the seaside town of Port Ellery; she moved there last spring to study marine biology."
    },
    {
      "key": "memory:h3:port-ellery-festival",
      "text": "Port Ellery hosts a kite festival on its beach every August."
    },
    {
      "key": "memory:h3:azadeh-portuguese",
      "text": "Azadeh is learning Portuguese at the Larkspur Language Centre on Thursdays."
    },
    {
      "key": "memory:h3:azadeh-dentist",
      "text": "Azadeh's dentist appointment is on 9 June at 3 p.m."
    },
    {
      "key": "memory:h3:yusuf-cello",
      "text": "Yusuf plays the cello in the Fenwick Community Orchestra."
    },
    {
      "key": "memory:h3:fenwick-rehearsal",
      "text": "The Fenwick Community Orchestra rehearses on Tuesday evenings in the basement of Corran Hall."
    },
    {
      "key": "memory:h3:yusuf-flight",
      "text": "Yusuf's flight to Reykjavik is on 14 March and leaves from gate B22."
    },
    {
      "key": "memory:h3:yusuf-bikeshed",
      "text": "The padlock code for the bike shed at Yusuf's building is 3381."
    },
    {
      "key": "memory:h3:thandiwe-dog",
      "text": "Thandiwe's dog is a retired greyhound named Marlowe."
    },
    {
      "key": "memory:h3:marlowe-vet",
      "text": "Marlowe the greyhound is registered with Dr. Osei at the Clearwater vet practice."
    },
    {
      "key": "memory:h3:osei-volunteer",
      "text": "Dr. Osei also volunteers at the Saltmarsh wildlife rescue on weekends."
    },
    {
      "key": "memory:h3:thandiwe-pottery",
      "text": "Thandiwe goes to a pottery class at the Kilnworks studio on Saturdays."
    },
    {
      "key": "memory:h3:thandiwe-alarm",
      "text": "Thandiwe's home alarm PIN is 5520."
    },
    {
      "key": "memory:h3:rosalind-locker",
      "text": "Rosalind's gym locker is number 87."
    },
    {
      "key": "memory:h3:bertrand-locker",
      "text": "Bertrand's gym locker is number 212."
    },
    {
      "key": "memory:h3:rosalind-fig",
      "text": "Rosalind waters the fiddle-leaf fig on her balcony every Sunday morning."
    },
    {
      "key": "memory:h3:bertrand-lyon",
      "text": "Bertrand grew up in Lyon and still speaks French with his parents."
    },
    {
      "key": "memory:h3:bertrand-library",
      "text": "Bertrand's library books are due back on 3 October."
    }
