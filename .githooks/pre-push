#!/bin/sh
# Scope fail-closed freshness checks to pushed evidence changes, not other agents'
# unrelated runtime or documentation branches. No GitHub Actions required.
set -eu
cd "$(git rev-parse --show-toplevel)"
. .githooks/benchmark-refresh-paths.sh
zeros="0000000000000000000000000000000000000000"
needs_refresh=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  # Deleted branch/tag cannot introduce new evidence.
  [ "$local_sha" = "$zeros" ] && continue
  if [ "$remote_sha" != "$zeros" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    # Newly created remote branches have no remote SHA. Compare with common
    # main history; do not inspect only HEAD (may be a reporting companion).
    base=""
    for default in refs/remotes/origin/main refs/heads/main; do
      if git show-ref --verify --quiet "$default"; then
        base="$(git merge-base "$local_sha" "$default" || true)"
        [ -n "$base" ] && break
      fi
    done
    if [ -z "$base" ]; then
      echo "benchmark publication BLOCKED: cannot establish pushed ref ancestry $local_ref" >&2
      exit 1
    fi
  fi
  if git diff --name-only "$base" "$local_sha" | benchmark_refresh_paths >/dev/null; then
    needs_refresh=1
  fi
done
[ "$needs_refresh" -eq 1 ] || exit 0
PYTHON="$(command -v python3 || command -v python || true)"
if [ -z "$PYTHON" ]; then
  echo "benchmark publication BLOCKED: Python missing for evidence-bearing push" >&2
  exit 1
fi
"$PYTHON" scripts/refresh_benchmark_pages.py --check || {
  echo "benchmark publication BLOCKED: accepted/recorded evidence projections are stale; run local governed refresh and commit results." >&2
  exit 1
}
