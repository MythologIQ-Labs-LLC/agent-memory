{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MythologIQ-Labs-LLC/agent-memory/schemas/reusable-grant.schema.json",
  "title": "Ratified Reusable Grant",
  "type": "object",
  "required": ["schema_version","grant_id","proposal_id","ratification_ref","ratifying_principal_ref","ratifier_authority_evidence_ref","ratifier_authority_verified","operation","scope_refs","material_conditions","policy_version_ref","issued_at","expires_at","revocation_mechanism_ref","evidence_refs","source_class","reusable_authority","authority_effect","can_widen_pama","can_widen_scope","can_create_autonomy_policy"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "grant_id": {"type": "string", "pattern": "^reusable-grant:sha256:[0-9a-f]{64}$"},
    "proposal_id": {"type": "string", "pattern": "^grant-proposal:sha256:[0-9a-f]{64}$"},
    "ratification_ref": {"type": "string", "minLength": 1},
    "ratifying_principal_ref": {"type": "string", "minLength": 1},
    "ratifier_authority_evidence_ref": {"type": "string", "minLength": 1},
    "ratifier_authority_verified": {"const": true},
    "operation": {"type": "string", "minLength": 1},
    "scope_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "material_conditions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name","value"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {}}, "additionalProperties": false}},
    "policy_version_ref": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocation_mechanism_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_class": {"const": "explicit_ratification"},
    "reusable_authority": {"const": true},
    "authority_effect": {"const": "scoped_reusable_review_grant"},
    "can_widen_pama": {"const": false},
    "can_widen_scope": {"const": false},
    "can_create_autonomy_policy": {"const": false}
  },
  "additionalProperties": false
}
