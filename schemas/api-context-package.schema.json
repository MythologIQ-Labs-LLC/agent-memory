{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythologiq.ai/agent-memory/schemas/api-context-package.schema.json",
  "title": "Agent Memory context package (#691 candidate agent-memory-context/0.1.0; #819 experimental evidence-qualified 0.2.0)",
  "description": "The authorized content of exactly the facts one public recall returned, resolved under the same serialization boundary as that recall, with provenance receipts, budgets and explicit item and package states. Separately versioned from the 1.x result envelope; not part of an accepted contract. Memory content is untrusted evidence and never authority. Package 0.2.0 is produced only by the opt-in consumer_profile=\"evidence_qualified\": it adds the omitted_selection item state and the selection block; the default profile still produces 0.1.0 byte-compatibly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_version",
    "status",
    "items",
    "budget",
    "recall",
    "consistency",
    "instruction_policy",
    "authority_effect"
  ],
  "properties": {
    "package_version": {
      "enum": [
        "agent-memory-context/0.1.0",
        "agent-memory-context/0.2.0"
      ]
    },
    "status": {
      "enum": [
        "empty",
        "complete",
        "truncated",
        "budget_exhausted",
        "partial_unresolved"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_ref",
          "state",
          "trust",
          "authority_effect"
        ],
        "properties": {
          "fact_ref": {
            "type": "string",
            "minLength": 1
          },
          "rank_position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "state": {
            "enum": [
              "resolved",
              "truncated",
              "omitted_budget",
              "unresolved",
              "unsupported",
              "omitted_selection"
            ]
          },
          "reason": {
            "enum": [
              "withheld",
              "not_found",
              "no_longer_admissible",
              "content_read_failed",
              "no_text_content",
              "no_query_term_evidence",
              "subject_mismatch",
              "attribute_unevidenced"
            ]
          },
          "content": {
            "type": "string"
          },
          "trust": {
            "const": "untrusted_memory_text"
          },
          "authority_effect": {
            "const": "none"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content_sha256",
              "content_chars"
            ],
            "properties": {
              "memory_ref": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "recorded_at": {
                "type": "string"
              },
              "observed_at": {
                "type": "string"
              },
              "valid_from": {
                "type": "string"
              },
              "valid_until": {
                "type": "string"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "content_chars": {
                "type": "integer",
                "minimum": 0
              },
              "admission_decision_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "admission_mode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "write_channel": {
                "type": "string"
              },
              "currentness": {
                "type": "string"
              },
              "replacement_kind": {
                "type": "string"
              },
              "replaced_at": {
                "type": "string"
              },
              "historical_valid_from": {
                "type": "string"
              },
              "historical_valid_until": {
                "type": "string"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "resolved",
                    "truncated"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "content",
                "provenance"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "omitted_budget",
                    "unresolved",
                    "unsupported",
                    "omitted_selection"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "content"
                    ]
                  },
                  {
                    "required": [
                      "provenance"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "unresolved",
                    "unsupported"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "omitted_selection"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "no_query_term_evidence",
                    "subject_mismatch",
                    "attribute_unevidenced"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "max_chars_per_item",
        "max_total_chars",
        "max_tokens",
        "used_chars",
        "used_tokens_estimate",
        "token_estimate"
      ],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_chars_per_item": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "used_chars": {
          "type": "integer",
          "minimum": 0
        },
        "used_tokens_estimate": {
          "type": "integer",
          "minimum": 0
        },
        "token_estimate": {
          "type": "string"
        }
      }
    },
    "recall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "returned",
        "return_policy",
        "public_projection"
      ],
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "returned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "return_policy": {
          "type": "object"
        },
        "public_projection": {
          "type": "object"
        }
      }
    },
    "consistency": {
      "const": "single_serialized_recall_and_resolution"
    },
    "instruction_policy": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "none"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_event_id",
        "recall_event_id",
        "correlation_id"
      ],
      "description": "The content-delivery audit receipt this package was delivered under (memory-audit-event memory.context_delivery): the receipt's event id, the memory.recall event it is caused by, and the correlation id both share. Identifiers only; a package is never delivered under a receipt that is not bound to its recall event.",
      "properties": {
        "delivery_event_id": {
          "type": "string",
          "minLength": 1
        },
        "recall_event_id": {
          "type": "string",
          "minLength": 1
        },
        "correlation_id": {
          "type": "string"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_profile",
        "policy_id",
        "policy_version",
        "basis",
        "query_terms",
        "query_subjects",
        "decisions",
        "delivered_refs",
        "omitted_refs",
        "delivered_count",
        "omitted_count",
        "uncertain_count",
        "omitted_reasons",
        "assessment",
        "authority_effect"
      ],
      "properties": {
        "consumer_profile": {
          "const": "evidence_qualified"
        },
        "policy_id": {
          "const": "evidence-qualified-context-selection"
        },
        "policy_version": {
          "const": "0.3.0"
        },
        "basis": {
          "const": "post_admission_query_evidence_qualification"
        },
        "query_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "query_subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "delivered",
                  "omitted",
                  "unavailable"
                ]
              },
              "evidence": {
                "enum": [
                  "preserved_exact_identity",
                  "preserved_corroborated_route",
                  "preserved_historical_admission",
                  "subject_and_attribute_evidence",
                  "query_term_evidence",
                  "subject_only_evidence",
                  "ungrounded_subject",
                  "undetermined_query",
                  "undetermined_multi_statement",
                  "attribute_undetermined"
                ]
              },
              "reason": {
                "enum": [
                  "no_query_term_evidence",
                  "subject_mismatch",
                  "attribute_unevidenced"
                ]
              },
              "certainty": {
                "enum": [
                  "grounded",
                  "uncertain"
                ]
              },
              "state": {
                "type": "string"
              },
              "currentness": {
                "type": "string"
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matched_terms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "query_subjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fact_subjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "single_statement": {
                "type": "boolean"
              }
            }
          }
        },
        "delivered_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "omitted_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivered_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "assessment": {
          "enum": [
            "evidence_delivered",
            "undetermined",
            "no_relevant_evidence",
            "no_returned_candidates"
          ]
        },
        "authority_effect": {
          "const": "none"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "empty"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "state": {
                  "const": "omitted_selection"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "state": {
                  "enum": [
                    "resolved",
                    "omitted_selection"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "package_version": {
            "const": "agent-memory-context/0.2.0"
          }
        }
      },
      "then": {
        "required": [
          "selection"
        ]
      },
      "else": {
        "not": {
          "required": [
            "selection"
          ]
        }
      }
    }
  ]
}
