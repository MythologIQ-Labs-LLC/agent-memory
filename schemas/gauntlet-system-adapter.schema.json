{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MythologIQ-Labs-LLC/agent-memory/schemas/gauntlet-system-adapter.schema.json",
  "title": "Agent Memory Gauntlet System Adapter Manifest",
  "description": "System-neutral identity, transport, and capability declarations for one memory system entering the Agent Memory Gauntlet. Capability declarations are descriptive evidence only and have authority_effect none.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_family", "contract_version", "system", "adapter", "transport", "capabilities", "authority_effect"],
  "properties": {
    "contract_family": {"const": "agent-memory-gauntlet-system-adapter"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "revision": {"type": "string", "minLength": 1},
        "configuration_digest": {
          "type": ["string", "null"],
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["stdio", "http", "in_process"]},
        "startup": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "endpoint": {"type": "string", "minLength": 1},
        "callable": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "stdio"}}, "required": ["kind"]},
          "then": {"required": ["startup"]}
        },
        {
          "if": {"properties": {"kind": {"const": "http"}}, "required": ["kind"]},
          "then": {"required": ["endpoint"]}
        },
        {
          "if": {"properties": {"kind": {"const": "in_process"}}, "required": ["kind"]},
          "then": {"required": ["callable"]}
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "required": ["describe"],
      "additionalProperties": {"$ref": "#/$defs/capability"},
      "properties": {
        "describe": {"$ref": "#/$defs/capability"}
      }
    },
    "benchmark_isolation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {"enum": ["disposable_instance", "namespace", "tenant", "database", "container", "remote_test_project", "other"]},
        "description": {"type": ["string", "null"]}
      }
    },
    "metadata": {"type": "object"},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support"],
      "properties": {
        "support": {"enum": ["native", "mapped", "derived", "unsupported", "unknown"]},
        "version": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
