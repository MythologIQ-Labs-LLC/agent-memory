{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MythologIQ-Labs-LLC/agent-memory/schemas/api-result-envelope.schema.json",
  "title": "Agent Memory Public API: Result Envelope",
  "description": "What every public stage returns (Sprint 4a, contract 1.0.0): the contract version, the ADR-030 compatibility state of the input envelope, the stage that ran, and the decision projection; a receipt when a commit happened; a refusal when the adapter refused; candidates and admissions for recall; contract 1.2.0 (Sprint 4c-2, ADR-038) adds the action_authority and execution_evidence stages, the action_authority object and the witness document, and the decision's active constraints. Contract 1.3.0 (#548) defines recall candidates as domain-eligible candidates: raw discovery matches that fail the shared domain-eligibility prefilter are never caller-visible, and the recall result carries candidate_policy as per-recall proof of how candidates were formed (no identifiers, no counts). Contract 1.4.0 (#670) adds `returned` (the ranked admitted prefix under the recall context's budget; equal to `admitted` when unbudgeted) and `return_policy` (which policy returned it, the requested k, whether it truncated, and both counts; authority_effect none).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "compatibility",
    "stage"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0",
        "1.5.0"
      ]
    },
    "compatibility": {
      "type": "string",
      "enum": [
        "current",
        "migration_required",
        "incompatible",
        "unknown"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "none",
        "proposal",
        "approval",
        "commit",
        "recall",
        "forget",
        "history",
        "posture",
        "action_authority",
        "execution_evidence"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "allow_with_ledger",
        "require_review",
        "require_external_verification",
        "block",
        "abstain",
        "quarantine",
        "collect_more_evidence"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "permitted_actions",
        "prohibited_actions",
        "reasons",
        "policy_version",
        "discharge_authority"
      ],
      "properties": {
        "outcome": {
          "type": "string"
        },
        "permitted_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_version": {
          "type": "string"
        },
        "discharge_authority": {
          "type": "string"
        },
        "review_discharge": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "receipt": {
      "type": "object"
    },
    "committed": {
      "type": "boolean"
    },
    "fact_uuid": {
      "type": [
        "string",
        "null"
      ]
    },
    "refusal": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "admissions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "admitted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_fact_uuid",
        "state_version",
        "tombstoned",
        "events"
      ],
      "properties": {
        "current_fact_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "tombstoned": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rejected_values": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "posture": {
      "type": "object"
    },
    "action_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_ref",
        "bound",
        "execution_status",
        "ledger_required",
        "requirement",
        "composition_id"
      ],
      "properties": {
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "bound": {
          "type": "boolean"
        },
        "execution_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "ledger_required": {
          "type": "boolean"
        },
        "requirement": {
          "type": "string"
        },
        "composition_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "witness": {
      "type": "object"
    },
    "candidate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_scope",
        "prefilter_policy_id",
        "prefilter_policy_version",
        "prefilter_authority",
        "admission"
      ],
      "description": "How recall candidates were formed (contract 1.3.0). Never carries identifiers or counts of excluded matches.",
      "properties": {
        "candidate_scope": {
          "type": "string",
          "enum": [
            "domain_eligible"
          ]
        },
        "prefilter_policy_id": {
          "type": "string"
        },
        "prefilter_policy_version": {
          "type": "string"
        },
        "prefilter_authority": {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        "admission": {
          "type": "string",
          "enum": [
            "full_canonical_admission_on_every_candidate"
          ]
        }
      }
    },
    "returned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "return_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "requested_k",
        "applied",
        "admitted_count",
        "returned_count",
        "basis",
        "authority_effect"
      ],
      "description": "How `returned` was formed from `admitted` (contract 1.4.0): a ranked-prefix return budget applied after admission and after ranking. `applied` means truncated. Never authority.",
      "properties": {
        "policy_id": {
          "const": "ranked-prefix-return-budget"
        },
        "policy_version": {
          "const": "1.0.0"
        },
        "requested_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "applied": {
          "type": "boolean"
        },
        "admitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "const": "post_admission_ranking_prefix"
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "recall_control": {
      "type": "object",
      "description": "Shadow recall control (contract 1.5.0, #644 T-controller): the deterministic System-One controller's plan reported beside the unchanged default planner's execution, in the frozen controller contract's vocabulary. Present only when the facade was opened with recall_control=\"shadow\". Retrieval, admission and ranking are identical with or without it. `actual_stop` describes the default planner (no_evidence, frontier_exhausted, or max_candidates when a host-capped route returned its cap; max_candidates is conservative when exactly the cap qualified). `usage.elapsed_ms` is not deterministic. Never authority.",
      "additionalProperties": false,
      "required": [
        "mode",
        "controller_contract_version",
        "request",
        "response",
        "usage",
        "routes_executed",
        "route_candidate_counts",
        "shadow_delta",
        "actual_stop",
        "authority_effect"
      ],
      "properties": {
        "mode": {
          "const": "shadow"
        },
        "controller_contract_version": {
          "type": "string"
        },
        "request": {
          "type": "object",
          "required": [
            "operation",
            "available_capabilities",
            "budget",
            "policy_context"
          ]
        },
        "response": {
          "type": "object",
          "required": [
            "controller_identity",
            "operation",
            "decision_status",
            "evidence",
            "authority_effect"
          ],
          "properties": {
            "decision_status": {
              "enum": [
                "complete",
                "partial",
                "abstained",
                "budget_exhausted",
                "unavailable",
                "invalid_response"
              ]
            },
            "authority_effect": {
              "const": "none"
            }
          }
        },
        "usage": {
          "type": "object",
          "required": [
            "controller_decisions_used",
            "cache_hits",
            "elapsed_ms",
            "fallback_events"
          ]
        },
        "routes_executed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_candidate_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "shadow_delta": {
          "type": "object"
        },
        "actual_stop": {
          "type": "object",
          "required": [
            "actual_stop_reason",
            "stop_class",
            "controller_recommendation",
            "budget_state"
          ],
          "properties": {
            "actual_stop_reason": {
              "enum": [
                "no_evidence",
                "frontier_exhausted",
                "max_candidates"
              ]
            },
            "stop_class": {
              "enum": [
                "search_space",
                "resource"
              ]
            }
          }
        },
        "authority_effect": {
          "const": "none"
        }
      }
    }
  }
}
