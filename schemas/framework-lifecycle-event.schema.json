{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MythologIQ-Labs-LLC/agent-memory/schemas/framework-lifecycle-event.schema.json",
  "title": "Agent Memory Framework Lifecycle Event",
  "description": "Vendor-neutral evidence binding framework runtime/checkpoint activity to Agent Memory governance state without treating framework persistence as memory admission or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "event_id",
    "framework",
    "event_type",
    "run_ref",
    "workflow_ref",
    "persistence_classification",
    "binding_status",
    "binding_reasons",
    "occurred_at",
    "evidence_refs",
    "interpretation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_version": { "const": "0.1.0" },
    "event_id": { "type": "string", "pattern": "^framework-event:sha256:[0-9a-f]{64}$" },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_id", "version", "source_ref"],
      "properties": {
        "framework_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "event_type": {
      "type": "string",
      "enum": [
        "run_started",
        "recall_requested",
        "recall_admitted",
        "mutation_proposed",
        "mutation_committed",
        "mutation_denied",
        "checkpoint_saved",
        "checkpoint_write_failed",
        "retry",
        "resume"
      ]
    },
    "run_ref": { "type": "string", "minLength": 1 },
    "workflow_ref": { "type": "string", "minLength": 1 },
    "session_ref": { "type": "string", "minLength": 1 },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_ref", "relation_to_latest"],
      "properties": {
        "checkpoint_ref": { "type": "string", "minLength": 1 },
        "previous_checkpoint_ref": { "type": "string", "minLength": 1 },
        "relation_to_latest": {
          "type": "string",
          "enum": ["current", "stale", "divergent", "unknown"]
        },
        "checkpoint_format_version": { "type": "string", "minLength": 1 },
        "iteration_count": { "type": "integer", "minimum": 0 }
      }
    },
    "persistence_classification": {
      "type": "string",
      "enum": ["execution_state", "evidence", "memory_candidate", "explicit_non_memory"]
    },
    "action_ref": { "type": "string", "minLength": 1 },
    "input_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "pama_decision_ref": { "type": "string", "minLength": 1 },
    "decision_receipt_ref": { "type": "string", "minLength": 1 },
    "composition_ref": { "type": "string", "minLength": 1 },
    "approval_evidence_ref": { "type": "string", "minLength": 1 },
    "execution_witness_ref": { "type": "string", "minLength": 1 },
    "trace_correlation_ref": { "type": "string", "minLength": 1 },
    "scope_ref": { "type": "string", "minLength": 1 },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "project_ref": { "type": "string", "minLength": 1 },
    "memory_state_ref": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "binding_status": {
      "type": "string",
      "enum": ["exact", "mismatch", "not_evaluated"]
    },
    "binding_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_effect",
        "memory_admission",
        "lifecycle_satisfaction",
        "checkpoint_rollback_authority"
      ],
      "properties": {
        "authority_effect": { "const": "none" },
        "memory_admission": { "const": "not_established" },
        "lifecycle_satisfaction": { "const": "not_established" },
        "checkpoint_rollback_authority": { "const": "not_established" }
      }
    }
  }
}
